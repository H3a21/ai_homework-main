MYSQL_ROOT_PASSWORD=root123
REDIS_PASSWORD=redis123
RABBITMQ_USER=grader
RABBITMQ_PASS=grader_pass
MINIO_USER=minioadmin
MINIO_PASS=minioadmin
MINIO_BUCKET=ai-homework-submissions
MINIO_SECURE=false
MYSQL_BACKUP_BUCKET=ai-homework-backups
MYSQL_BACKUP_RETENTION_DAYS=30
MYSQL_BACKUP_TIME=03:00
MYSQL_BACKUP_RUN_ON_STARTUP=true
MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_SUBMISSION_IMAGES=10
GRADER_VERSION=1.0.0
# Optional personalized comments. Leave LLM_API_KEY empty to use deterministic templates.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8
LLM_MAX_COMPLETION_TOKENS=240
LLM_MAX_OUTPUT_CHARS=500
# Use max_tokens for compatible providers that do not accept max_completion_tokens.
LLM_TOKEN_PARAMETER=max_completion_tokens
REPORT_CACHE_TTL_SECONDS=300
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:4173
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-strong-random-secret
JWT_PEPPER=replace-with-a-random-pepper
